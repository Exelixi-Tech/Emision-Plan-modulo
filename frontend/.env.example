# ── Build local (dev) ──────────────────────────────────────────────────────────
# cierrelmds:  /emision/
VITE_APP_BASE=/

# URL de nexus-api (SSO, verify, bridge)
# Local:       http://localhost:3092
# cierrelmds:  https://cierrelmds.exelixitech.com/nexus-api
VITE_NEXUS_API_URL=https://cierrelmds.exelixitech.com/nexus-api

# API Key de empresa (opcional en dev)
VITE_NEXUS_API_KEY=

# Id(s) de rol de Sis2000 (serol.crol) que son corredor/productor y NO ven el selector de productor.
# Lista separada por comas. Ej: 6
VITE_CROL_PRODUCTOR=

# Combinado Familiar / Plan Proveedor (pantalla de plan + proveedor). VACIA = desactivado: todo
# sigue igual (Combinado se emite por el flujo de personas). Para activarlo (p. ej. en QA), crear
# frontend/.env.production.local (no se versiona) con el cproducto y recompilar:
#   VITE_LAMUNDIAL_PRODUCTOS_PROVEEDOR=51
VITE_LAMUNDIAL_PRODUCTOS_PROVEEDOR=
